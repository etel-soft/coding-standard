# The PHPStan rules of the etel coding standard. A project includes this file and turns rules off
# (or names its JSON/XML wrapper) under `parameters.etel`:
#
#   includes:
#       - vendor/etel/coding-standard/extension.neon
#   parameters:
#       etel:
#           jsonWrapper: App\Json
#           doubleConfigurator: false
#           methodLength: 80
#
# The size limits are numbers; 0 turns the limit off.

parametersSchema:
    etel: structure([
        namedArguments: bool(),
        stringInterpolation: bool(),
        doubleConfigurator: bool(),
        rawJson: bool(),
        jsonWrapper: schema(string(), nullable()),
        rawXml: bool(),
        xmlWrapper: schema(string(), nullable()),
        ormRepository: bool(),
        methodComplexity: int(),
        methodLength: int(),
        classComplexity: int(),
        classLength: int(),
        testClassLength: int(),
        constructorDependencies: int(),
        testPaths: listOf(string()),
        constructorDependenciesExempt: listOf(string()),
    ])

parameters:
    etel:
        # named arguments wherever possible
        namedArguments: true
        # concatenation, never interpolation
        stringInterpolation: true
        # test doubles via the etel/phpunit-double configurators
        doubleConfigurator: true
        # JSON only through the wrapper class (null: no class may call json_*)
        rawJson: true
        jsonWrapper: null
        # XML only through the wrapper class (null: no class may call simplexml_load_*)
        rawXml: true
        xmlWrapper: null
        # no Doctrine repositories: neither getRepository() nor repository classes
        ormRepository: true
        # the most cognitive complexity of a method / of a class (the sum of its methods'); tests are left out
        methodComplexity: 15
        classComplexity: 60
        # the most lines of a method / of a class (docblock not counted); methods of tests are left out
        methodLength: 50
        classLength: 500
        testClassLength: 2500
        # the most objects a constructor takes, outside tests and the namespaces listed (say, '\Domain\')
        constructorDependencies: 8
        constructorDependenciesExempt: []
        # test code, held to the test limits: PHPUnit test cases and whatever lies in these paths
        testPaths: ['/tests/']

conditionalTags:
    Etel\CodingStandard\PHPStan\NamedArgumentsRule:
        phpstan.rules.rule: %etel.namedArguments%
    Etel\CodingStandard\PHPStan\NoStringInterpolationRule:
        phpstan.rules.rule: %etel.stringInterpolation%
    Etel\CodingStandard\PHPStan\DoubleConfiguratorRule:
        phpstan.rules.rule: %etel.doubleConfigurator%
    Etel\CodingStandard\PHPStan\NoRawJsonRule:
        phpstan.rules.rule: %etel.rawJson%
    Etel\CodingStandard\PHPStan\NoRawXmlRule:
        phpstan.rules.rule: %etel.rawXml%
    Etel\CodingStandard\PHPStan\NoOrmRepositoryRule:
        phpstan.rules.rule: %etel.ormRepository%
    Etel\CodingStandard\PHPStan\NoOrmRepositoryClassRule:
        phpstan.rules.rule: %etel.ormRepository%

services:
    - class: Etel\CodingStandard\PHPStan\NamedArgumentsRule
    - class: Etel\CodingStandard\PHPStan\NoStringInterpolationRule
    - class: Etel\CodingStandard\PHPStan\DoubleConfiguratorRule
    - class: Etel\CodingStandard\PHPStan\NoRawJsonRule
      arguments:
          wrapper: %etel.jsonWrapper%
    - class: Etel\CodingStandard\PHPStan\NoRawXmlRule
      arguments:
          wrapper: %etel.xmlWrapper%
    - class: Etel\CodingStandard\PHPStan\NoOrmRepositoryRule
    - class: Etel\CodingStandard\PHPStan\NoOrmRepositoryClassRule
    - class: Etel\CodingStandard\PHPStan\Size\TestClass
      arguments:
          paths: %etel.testPaths%
    - class: Etel\CodingStandard\PHPStan\MethodComplexityRule
      arguments:
          limit: %etel.methodComplexity%
      tags: [phpstan.rules.rule]
    - class: Etel\CodingStandard\PHPStan\MethodLengthRule
      arguments:
          limit: %etel.methodLength%
      tags: [phpstan.rules.rule]
    - class: Etel\CodingStandard\PHPStan\ClassComplexityRule
      arguments:
          limit: %etel.classComplexity%
      tags: [phpstan.rules.rule]
    - class: Etel\CodingStandard\PHPStan\ClassLengthRule
      arguments:
          limit: %etel.classLength%
          testLimit: %etel.testClassLength%
      tags: [phpstan.rules.rule]
    - class: Etel\CodingStandard\PHPStan\ConstructorDependenciesRule
      arguments:
          limit: %etel.constructorDependencies%
          exempt: %etel.constructorDependenciesExempt%
      tags: [phpstan.rules.rule]
