#!/usr/bin/env php
<?php

declare(strict_types=1);

/*
 * Line-length gate: no line of the PHP sources is longer than 120 characters, and no docblock is followed by
 * another one (see Etel\CodingStandard\LineLength\LineLengthGate).
 *
 * Runs in the package it checks (its working directory is the root):
 *
 *   vendor/bin/etel-line-length                         bin, config, migrations, public, src, tests, tools
 *   vendor/bin/etel-line-length src tests other-dir     only these (each must exist)
 */

use Etel\CodingStandard\LineLength\LineLengthGate;

require $GLOBALS['_composer_autoload_path'] ?? __DIR__ . '/../vendor/autoload.php';

/** @var list<string> $arguments */
$arguments = $_SERVER['argv'] ?? [];
$directories = \array_slice(array: $arguments, offset: 1);

try {
    ['long' => $long, 'orphans' => $orphans] = new LineLengthGate(root: (string) \getcwd())->check(
        directories: $directories
    );
} catch (InvalidArgumentException $exception) {
    \fwrite(stream: STDERR, data: $exception->getMessage() . PHP_EOL);

    exit(2);
}

foreach ([...$long, ...$orphans] as $line) {
    \fwrite(stream: STDERR, data: $line . PHP_EOL);
}

\fwrite(
    stream: $long === [] ? STDOUT : STDERR,
    data: $long === []
        ? 'No line is longer than ' . LineLengthGate::LIMIT . ' characters.' . PHP_EOL
        : \count(value: $long) . ' line(s) longer than ' . LineLengthGate::LIMIT . ' characters.' . PHP_EOL
);

if ($orphans !== []) {
    \fwrite(stream: STDERR, data: \count(value: $orphans) . ' docblock(s) followed by another docblock.' . PHP_EOL);
}

exit($long === [] && $orphans === [] ? 0 : 1);
